<div id="mystify-unbox-cta" style="display: none; border: 2px solid #e5e5e5; border-radius: 12px; padding: 24px; margin: 24px 0; text-align: center; background: linear-gradient(135deg, #f0f4ff, #faf5ff);">
  <h2 style="margin: 0 0 12px 0; font-size: 20px;">You have mystery boxes to open!</h2>
  <div id="mystify-unbox-list" style="margin-bottom: 16px;"></div>
</div>

<script>
(async function() {
  const orderId = window.location.pathname.match(/\/orders\/(\d+)/)?.[1];
  if (!orderId) return;

  try {
    const resp = await fetch('/apps/mystify/api/unopened-boxes?orderId=' + orderId);
    const data = await resp.json();
    if (!data.unopened || data.unopened.length === 0) return;

    const cta = document.getElementById('mystify-unbox-cta');
    const list = document.getElementById('mystify-unbox-list');
    cta.style.display = 'block';

    data.unopened.forEach(function(box) {
      const btn = document.createElement('a');
      btn.href = '/apps/mystify/unbox?boxPurchaseId=' + box.boxPurchaseId;
      btn.textContent = 'Open ' + (box.boxName || 'Mystery Box');
      btn.style.cssText = 'display:inline-block;padding:12px 24px;margin:4px;border-radius:8px;background:#4f46e5;color:#fff;text-decoration:none;font-weight:600;';
      list.appendChild(btn);
    });
  } catch(e) {}
})();
</script>
