// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model MysteryBox {
  id                               String     @id @default(cuid())
  shop                             String
  productId                        String
  productTitle                     String
  boxType                          String
  boxStatus                        String     @default("draft")
  smartStockManagement             Boolean    @default(false)
  preventDuplicateBundleSelections Boolean    @default(false)
  itemConfig                       String?
  bundleConfig                     String?
  createdAt                        DateTime   @default(now())
  updatedAt                        DateTime   @updatedAt

  boxDesign   BoxDesign?
  boxPurchases BoxPurchase[]

  @@unique([shop, productId])
  @@index([shop])
}

model BoxPurchase {
  id               String   @id @default(cuid())
  shop             String
  orderId          String
  orderLineItemId  String
  mysteryBoxId     String
  price            String?
  quantity         Int      @default(1)
  status           String   @default("unopened")
  createdAt        DateTime @default(now())
  openedAt         DateTime?

  mysteryBox MysteryBox   @relation(fields: [mysteryBoxId], references: [id])
  reveals    BoxReveal[]

  @@index([shop, orderId])
}

model BoxReveal {
  id             String   @id @default(cuid())
  boxPurchaseId  String
  setId          Int?
  variantId      String
  itemName       String
  createdAt      DateTime @default(now())

  boxPurchase BoxPurchase @relation(fields: [boxPurchaseId], references: [id])

  @@index([boxPurchaseId])
}

model BoxDesign {
  id                 String  @id @default(cuid())
  mysteryBoxId       String  @unique
  animationStyle     String  @default("default")
  boxImageUrl        String?
  openSoundUrl       String?
  backgroundColor    String?
  backgroundImageUrl String?

  mysteryBox MysteryBox @relation(fields: [mysteryBoxId], references: [id])
}
